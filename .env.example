# Copy to .env and edit. docker-compose reads this automatically.
# ---------------------------------------------------------------------------

# Mock mode: simulate GitHub, no credentials needed. Set to false for real issues.
MOCK_GITHUB=true

# --- Required only when MOCK_GITHUB=false ---
# A fine-grained or classic PAT with "Issues: read & write" on the target repo.
# Create at https://github.com/settings/tokens
GITHUB_TOKEN=
# Where issues are opened, as "owner/name".
GITHUB_REPO=owner/repo

# --- Background poller (auto-check for new issues) ---
POLL_ENABLED=true
POLL_INTERVAL_SECONDS=60

# --- Host ports (change if 8000/8501 are already in use on your machine) ---
API_PORT=8000
UI_PORT=8501
